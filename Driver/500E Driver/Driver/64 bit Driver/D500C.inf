[Version]
Signature="$CHICAGO$"
Class=Image
ClassGuid = {6bdd1fc6-810f-11d0-bec7-08002be2092f}
provider=%GR%
DriverVer =05/01/2011,2.0.0.2
LayoutFile=layout.inf


[Manufacturer]
%GR%=GR, NTx86, NTamd64

[GR.NTx86]
%USB\VID_0547&PID_4D35.DeviceDesc%=D500C.Dev, USB\VID_0547&PID_4D35

[GR.NTamd64]
%USB\VID_0547&PID_4D35.DeviceDesc%=D500C64.Dev, USB\VID_0547&PID_4D35

[DestinationDirs]
DefaultDestDir=11
;10 is the windows directory
;11 is the systems directory
D500C.Files.Ext      = 10,System32\Drivers
D500C64.Files.Ext    = 10,System32\Drivers
D500C.Files.Sys32    = 10,System32
D500C.Files.TWain_32 = 10,TWain_32
D500C64.Files.Sys64  = 10,SysWOW64

[SourceDisksNames]
1 = %D500C.SvcDesc%
1 = %D500C64.SvcDesc%

[SourceDisksFiles]
D500C.sys = 1
D500C64.sys = 1
D500C.ax = 1
D500C.ds = 1


[D500C.Dev]
DelFiles  = D500C.Files.Ext, D500C.Files.TWain_32,D500C.Files.Sys32
CopyFiles = D500C.Files.Ext, D500C.Files.TWain_32,D500C.Files.Sys32
DelReg=D500C.DelReg
AddReg=D500C.AddReg

[D500C.Dev.NT]
DelFiles  = D500C.Files.Ext, D500C.Files.TWain_32,D500C.Files.Sys32
CopyFiles = D500C.Files.Ext, D500C.Files.TWain_32,D500C.Files.Sys32
DelReg=D500C.DelReg
AddReg=D500C.AddReg

[D500C64.Dev]
DelFiles  = D500C64.Files.Ext,D500C64.Files.Sys64,D500C.Files.TWain_32
CopyFiles = D500C64.Files.Ext,D500C64.Files.Sys64,D500C.Files.TWain_32
DelReg=D500C64.DelReg
AddReg=D500C64.AddReg

[D500C64.Dev.NT]
DelFiles  = D500C64.Files.Ext,D500C64.Files.Sys64,D500C.Files.TWain_32
CopyFiles = D500C64.Files.Ext,D500C64.Files.Sys64,D500C.Files.TWain_32
DelReg=D500C64.DelReg
AddReg=D500C64.AddReg

[D500C.Dev.NT.Services]
Addservice = D500C, 0x00000002, D500C.AddService

[D500C64.Dev.NT.Services]
Addservice = D500C, 0x00000002, D500C64.AddService

[D500C.AddService]
DisplayName    = %D500C.SvcDesc%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_AUTO_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %10%\System32\Drivers\D500C.sys
LoadOrderGroup = Base

[D500C64.AddService]
DisplayName    = %D500C64.SvcDesc%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_AUTO_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %10%\System32\Drivers\D500C64.sys
LoadOrderGroup = Base

[D500C.Files.Ext]
D500C.sys

[D500C64.Files.Ext]
D500C64.sys

[D500C.Files.Sys32]
D500C.ax


[D500C.Files.TWain_32]
D500C.ds

[D500C64.Files.Sys64]
D500C.ax

[D500C.AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,D500C.sys
HKR,,CLSID,,%D500C.CAMERAGUID%
HKR,,FriendlyName,,%USB\VID_0547&PID_4D35.DeviceDesc%

;CAMERAGUID
HKCR,CLSID\%D500C.CAMERAGUID%,,,%USB\VID_0547&PID_4D35.DeviceDesc%
HKCR,CLSID\%D500C.CAMERAGUID%\InprocServer32,,,D500C.ax
HKCR,CLSID\%D500C.CAMERAGUID%\InprocServer32,ThreadingModel,,Both

