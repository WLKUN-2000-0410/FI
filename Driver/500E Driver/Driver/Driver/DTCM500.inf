[Version]
Signature="$CHICAGO$"
Class=Image
ClassGuid = {6bdd1fc6-810f-11d0-bec7-08002be2092f}
provider=%OuMain%
DriverVer = 01/18/2008,3.00
LayoutFile=layout.inf
DriverPackageType = PlugAndPlay

[Manufacturer]
%OuMain%=OuMain

[OuMain]
%USB\VID_0547&PID_4D35.DeviceDesc%=DTCM500.Dev, USB\VID_0547&PID_4D35

[DestinationDirs]
DefaultDestDir=11
;10 is the windows directory
;11 is the systems directory
DTCM500.Files.Ext   = 10,System32\Drivers
DTCM500.Files.Inf   = 10,INF
DTCM500.Files.Sys32 = 10,System32
DTCM500.Files.TWain_32 = 10,TWain_32

[SourceDisksNames]
1 = %DTCM500.SvcDesc%

[SourceDisksFiles]
DTCM500.sys = 1
DTCM500.ax = 1
DTCM500.ds = 1


[DTCM500.Dev]
CopyFiles=DTCM500.Files.Ext, DTCM500.Files.Inf,DTCM500.Files.TWain_32,DTCM500.Files.Sys32
AddReg=DTCM500.AddReg

[DTCM500.Dev.NT]
; copyfiles commented out for Win2K to avoid user intervention during install
CopyFiles=DTCM500.Files.Ext, DTCM500.Files.Inf, DTCM500.Files.TWain_32,DTCM500.Files.Sys32
AddReg=DTCM500.AddReg

[DTCM500.Dev.NT.Services]
Addservice = DTCM500, 0x00000002, DTCM500.AddService

[DTCM500.AddService]
DisplayName    = %DTCM500.SvcDesc%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_AUTO_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %10%\System32\Drivers\DTCM500.sys
LoadOrderGroup = Base

[DTCM500.Files.Ext]
DTCM500.sys

[DTCM500.Files.Inf]
DTCM500.Inf

[DTCM500.Files.Sys32]
DTCM500.ax

[DTCM500.Files.TWain_32]
DTCM500.ds

[DTCM500.AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,DTCM500.sys

HKR,,CLSID,,%DTCM500.CAMERAGUID%
HKR,,FriendlyName,,%USB\VID_0547&PID_4D35.DeviceDesc%

;CAMERAGUID
HKCR,CLSID\%DTCM500.CAMERAGUID%,,,%USB\VID_0547&PID_4D35.DeviceDesc%
HKCR,CLSID\%DTCM500.CAMERAGUID%\InprocServer32,,,DTCM500.ax
HKCR,CLSID\%DTCM500.CAMERAGUID%\InprocServer32,ThreadingModel,,Both

;SETUPGUID
HKCR,CLSID\%DTCM500.SETUPGUID%,,,%DTCM500.Setup%
HKCR,CLSID\%DTCM500.SETUPGUID%\InprocServer32,,,DTCM500.ax
HKCR,CLSID\%DTCM500.SETUPGUID%\InprocServer32,ThreadingModel,,Both

;SIZEGUID
HKCR,CLSID\%DTCM500.SIZEGUID%,,,%DTCM500.Size%"
HKCR,CLSID\%DTCM500.SIZEGUID%\InprocServer32,,,DTCM500.ax
HKCR,CLSID\%DTCM500.SIZEGUID%\InprocServer32,ThreadingModel,,Both

;Associate the property set with the property page
HKCR,CLSID\%DTCM500.VideoFilter%\Instance\%DTCM500.CAMERAGUID%,FriendlyName,,%USB\VID_0547&PID_4D35.DeviceDesc%
