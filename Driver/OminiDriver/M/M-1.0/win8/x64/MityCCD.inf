
; Copyright (c) Critical Link LLC. All rights reserved.

[Version]
Signature="$Windows NT$"
DriverVer=03/21/2016,1.09.03.0
Class=USB
ClassGUID={36FC9E60-C465-11CF-8056-444553540000}
CatalogFile=MityCCD.cat
Provider=%CYUSB3_Provider%

;+
; Identify the installation media
;-
[SourceDisksNames]
1=%CYUSB3_Install%,,,

;+
; Identify the files on the installation media
;-
[SourceDisksFiles]
MityCCD.spt = 1
CYUSB3.SYS = 1


;+
; Identify where the files will be copied to
;-
[DestinationDirs]
CYUSB3.Files.Ext = 10,System32\Drivers
MityCCD.Files.Ext = 10,System32\MityCCD

[ControlFlags]
ExcludeFromSelect = *


[Manufacturer]
%CYUSB3_Provider%=Device,NT,NTx86,NTamd64

;for all platforms
[Device.NT]
%VID_1EF8&PID_1005.DeviceDesc%=CyUsb3, USB\VID_1EF8&PID_1005
%VID_1EF8&PID_1004.DeviceDesc%=MityCCD, USB\VID_1EF8&PID_1004


;for x86 platforms
[Device.NTx86]
%VID_1EF8&PID_1005.DeviceDesc%=CyUsb3, USB\VID_1EF8&PID_1005
%VID_1EF8&PID_1004.DeviceDesc%=MityCCD, USB\VID_1EF8&PID_1004


;for x64 platforms
[Device.NTamd64]
%VID_1EF8&PID_1005.DeviceDesc%=CyUsb3, USB\VID_1EF8&PID_1005
%VID_1EF8&PID_1004.DeviceDesc%=MityCCD, USB\VID_1EF8&PID_1004

[MityCCD.NT]
CopyFiles=CYUSB3.Files.Ext, MityCCD.Files.Ext
AddReg=CYUSB3.AddReg

[MityCCD.NT.HW]
AddReg=MityCCD.AddReg.Guid

[MityCCD.NT.Services]
Addservice = CYUSB3,2,CYUSB3.AddService

[MityCCD.NTx86]
CopyFiles=CYUSB3.Files.Ext, MityCCD.Files.Ext
AddReg=CYUSB3.AddReg

[MityCCD.NTx86.HW]
AddReg=MityCCD.AddReg.Guid

[MityCCD.NTx86.Services]
Addservice = CYUSB3,2,CYUSB3.AddService

[MityCCD.NTamd64]
CopyFiles=CYUSB3.Files.Ext, MityCCD.Files.Ext
AddReg=CYUSB3.AddReg

[MityCCD.NTamd64.HW]
AddReg=MityCCD.AddReg.Guid

[MityCCD.NTamd64.Services]
Addservice = CYUSB3,2,CYUSB3.AddService

[MityCCD.AddReg.Guid]
HKR,,DriverGUID,,%CYUSB3.GUID%
HKR,,DriverEXECSCRIPT,,%MityCCD.EXECSCRIPT%

[MityCCD.Files.Ext]
MityCCD.spt


;==============================================

[CYUSB3.NT]
CopyFiles=CYUSB3.Files.Ext
AddReg=CyUsb3.AddReg

[CYUSB3.NT.HW]
AddReg=CYUSB3.AddReg.Guid

[CYUSB3.NT.Services]
Addservice = CYUSB3,2,CYUSB3.AddService


[CYUSB3.NTx86]
CopyFiles=CYUSB3.Files.Ext
AddReg=CyUsb3.AddReg

[CYUSB3.NTx86.HW]
AddReg=CYUSB3.AddReg.Guid

[CYUSB3.NTx86.Services]
Addservice = CYUSB3,2,CYUSB3.AddService

[CYUSB3.NTamd64]
CopyFiles=CYUSB3.Files.Ext
AddReg=CyUsb3.AddReg

[CYUSB3.NTamd64.HW]
AddReg=CYUSB3.AddReg.Guid

[CYUSB3.NTamd64.Services]
Addservice = CYUSB3,2,CYUSB3.AddService


[CYUSB3.AddReg]
; Deprecating - do not use in new apps to identify a CYUSB3 driver
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,CYUSB3.sys
; You may optionally include a check for DriverBase in your application to check for a CYUSB3 driver
HKR,,DriverBase,,CYUSB3.sys
HKR,"Parameters","MaximumTransferSize",0x10001,4096
HKR,"Parameters","DebugLevel",0x10001,2
HKR,,FriendlyName,,%CYUSB3_Description%

[CYUSB3.AddService]
DisplayName    = %CYUSB3_Description%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_DEMAND_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %10%\System32\Drivers\CYUSB3.sys
AddReg         = CYUSB3.AddReg
LoadOrderGroup = Base

[CYUSB3.Files.Ext]
CYUSB3.sys

[CYUSB3.AddReg.Guid]
HKR,,DriverGUID,,%CYUSB3.GUID%
;HKR,,DriverPowerPolicySetup,,%ENABLE_DRIVER_POWER_POLICY%

;-------------- WDF Coinstaller installation
[SourceDisksFiles]
WdfCoInstaller01011.dll=1 ; make sure the number matches with SourceDisksNames

[DestinationDirs]
CoInstaller_CopyFiles = 11

[CYUSB3.NTamd64.CoInstallers]
AddReg=CoInstaller_AddReg
CopyFiles=CoInstaller_CopyFiles

[CYUSB3.NTx86.CoInstallers]
AddReg=CoInstaller_AddReg
CopyFiles=CoInstaller_CopyFiles

[CoInstaller_CopyFiles]
WdfCoInstaller01011.dll

[CoInstaller_AddReg]
HKR,,CoInstallers32,0x00010000, "WdfCoInstaller01011.dll,WdfCoInstaller"

[CYUSB3.NTamd64.Wdf]
KmdfService = CYUSB3, CYUSB3_wdfsect

[CYUSB3.NTx86.Wdf]
KmdfService = CYUSB3, CYUSB3_wdfsect

[CYUSB3_wdfsect]
KmdfLibraryVersion = 1.11


;+
; String substitution definitions
;-
[Strings]
CYUSB3_Provider                         = "Critical Link LLC"
CYUSB3_Company                          = "Critical Link LLC"
CYUSB3_Description = "Scientific Camera Driver"
CYUSB3_DisplayName = "Scientific Camera"
CYUSB3_Install     = "Cypress CYUSB3.0 Driver Installation Disk"
VID_1EF8&PID_1004.DeviceDesc     = "Scientific Camera Loader"
VID_1EF8&PID_1005.DeviceDesc      = "Scientific Camera Driver"


CYUSB3.GUID="{AE18AA60-7F6A-11d4-97DD-00010229B959}"
;ENABLE_DRIVER_POWER_POLICY="1"
CYUSB3_Unused      = "."
MityCCD.EXECSCRIPT="\systemroot\system32\MityCCD\MityCCD.spt"


    