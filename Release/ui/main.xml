<?xml version="1.0" encoding="UTF-8"?>
<Window size="1440, 960" mininfo="1280,768" sizebox="4,4,4,4" roundcorner="6,6" caption="0,0,0,30" bktrans="false">
	<Font name="幼圆" size="16" default="true" />
	<!-- 实际主体窗口 -->
	<VerticalLayout name="main" bkcolor="#FF1111FF">
			<!-- 标题栏 -->
			<HorizontalLayout name="head" height="30" maxheight="30" bkcolor="#ffff00FF">
				
				<!-- 左边标题 -->
				<HorizontalLayout name="leftHead" >
					<Text name="title" text="自建库程序" bkcolor="#0000EEFF" align="left" valign="center"></Text>
				</HorizontalLayout>
				
				<!-- 右边标题 -->
				<HorizontalLayout name="rightHead" width="40">
					<Button name="closebtn" text="关闭" bkcolor="#0000EEFF" valign="center"></Button>
				</HorizontalLayout>
			</HorizontalLayout>
			
			<!-- 主体界面 -->
			<VerticalLayout name="body" bkcolor="#00ff00FF" >
				<!-- 选择添加文件 -->
				<HorizontalLayout>
					<Button name="selectFiles" text="选择添加文件" width="100" height="80"></Button>
				</HorizontalLayout>
				
				<!-- 图表 activex -->
